# Kick Halay - Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.

# Sunucu
PORT=3000
HOST=0.0.0.0

# Kick Developer App (https://kick.com/settings/developer)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:3000/auth/callback

# OAuth sonrası alınan tokenlar (otomatik kaydedilir, elle de girebilirsiniz)
KICK_ACCESS_TOKEN=
KICK_REFRESH_TOKEN=

# Yayıncı bilgisi (kanal slug veya user_id)
KICK_CHANNEL_SLUG=your_channel_slug
KICK_BROADCASTER_USER_ID=

# Webhook doğrulama (Kick Developer Portal'dan)
KICK_WEBHOOK_SECRET=

# Unofficial Pusher ile canlı sohbet dinleme (opsiyonel, test için kolay)
# true yaparsanız resmi webhook yerine/yanında Pusher kullanır
USE_UNOFFICIAL_CHAT=true

# Test modu (Kick bağlantısı olmadan çalışır)
TEST_MODE=true

# Maksimum oyuncu
MAX_PLAYERS=50
